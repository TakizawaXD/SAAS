{
  "name": "facturapro-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build:css": "tailwindcss -i ./src/tailwind-input.css -o ./src/tailwind-built.css --minify",
    "build": "npm run build:css && ng build",
    "build:dev": "npm run build:css && ng build --configuration development",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "jspdf": "^4.2.1",
    "rxjs": "~7.8.0",
    "semver": "^7.8.5",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "autoprefixer": "^10.6.1",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.30",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
