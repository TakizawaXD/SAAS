<UserControl x:Class="FacturaPro360.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BIENVENIDA -->
        <Border Grid.Row="0" Margin="0,0,0,20">
            <DockPanel LastChildFill="False">
                <StackPanel>
                    <TextBlock Text="Bienvenido, Dmitri" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}"/>
                    <TextBlock Text="Aquí tienes un resumen de la actividad de tu empresa." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                        <TextBlock Text="Período: 01/10/2025 - 31/10/2025" FontSize="11" Foreground="{StaticResource TextDarkBrush}"/>
                    </Border>
                    <Button Style="{StaticResource SecondaryBtn}" Content="Personalizar"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 4 TARJETAS MÉTRICAS (EXACTAS AL MOCKUP) -->
        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Ventas del período -->
            <Border Grid.Column="0" Style="{StaticResource FacturaCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Ventas del período" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="$ 12,450.00" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,8,0,0"/>
                    <TextBlock Text="+ 12.5% vs. período anterior" FontSize="10" FontWeight="Bold" Foreground="{StaticResource EmeraldBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Cobros recibidos -->
            <Border Grid.Column="1" Style="{StaticResource FacturaCard}" Margin="5,0,5,0">
                <StackPanel>
                    <TextBlock Text="Cobros recibidos" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="$ 8,230.00" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,8,0,0"/>
                    <TextBlock Text="+ 8.3% vs. período anterior" FontSize="10" FontWeight="Bold" Foreground="{StaticResource EmeraldBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Cuentas por cobrar -->
            <Border Grid.Column="2" Style="{StaticResource FacturaCard}" Margin="5,0,5,0">
                <StackPanel>
                    <TextBlock Text="Cuentas por cobrar" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="$ 3,420.00" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,8,0,0"/>
                    <TextBlock Text="- 4.1% vs. período anterior" FontSize="10" FontWeight="Bold" Foreground="{StaticResource RoseBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Cuentas por pagar -->
            <Border Grid.Column="3" Style="{StaticResource FacturaCard}" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Cuentas por pagar" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="$ 2,860.00" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,8,0,0"/>
                    <TextBlock Text="+ 2.7% vs. período anterior" FontSize="10" FontWeight="Bold" Foreground="{StaticResource EmeraldBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- SECCIÓN DE GRÁFICOS Y ACCIONES -->
        <Border Grid.Row="2" Style="{StaticResource FacturaCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Text="Ventas vs. Gastos (Últimos 30 días)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,12"/>
                    <Border Height="180" Background="#F8FAFC" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Tendencia Positiva de Facturación" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBlueBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Crecimiento de ventas del 12.5% sostenido con transacciones 100% locales sin conexión requerida." 
                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="450" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Estado de Cuentas" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,12"/>
                    <Border Background="#F8FAFC" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Al día (52%)" FontSize="11" Foreground="{StaticResource TextDarkBrush}"/>
                                <TextBlock Text="$ 1,778.40" FontSize="11" FontWeight="Bold" Foreground="{StaticResource EmeraldBrush}" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="1-30 días (24%)" FontSize="11" Foreground="{StaticResource TextDarkBrush}"/>
                                <TextBlock Text="$ 820.80" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AmberBrush}" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="31-60 días (15%)" FontSize="11" Foreground="{StaticResource TextDarkBrush}"/>
                                <TextBlock Text="$ 513.00" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="61+ días (9%)" FontSize="11" Foreground="{StaticResource TextDarkBrush}"/>
                                <TextBlock Text="$ 307.80" FontSize="11" FontWeight="Bold" Foreground="{StaticResource RoseBrush}" HorizontalAlignment="Right"/>
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
