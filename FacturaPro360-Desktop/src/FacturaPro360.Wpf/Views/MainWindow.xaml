<Window x:Class="FacturaPro360.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FacturaPro360.Wpf.ViewModels"
        xmlns:views="clr-namespace:FacturaPro360.Wpf.Views"
        Title="FacturaPro 360 — Enterprise Suite" 
        Height="860" Width="1340"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource CanvasBgBrush}"
        Foreground="{StaticResource TextDarkBrush}"
        Icon="/Assets/app_icon.ico"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.ClearTypeHint="Enabled">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FacturasViewModel}">
            <views:FacturasView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NuevaFacturaViewModel}">
            <views:NuevaFacturaView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DetalleFacturaViewModel}">
            <views:DetalleFacturaView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ClientesViewModel}">
            <views:ClientesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductosViewModel}">
            <views:ProductosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupViewModel}">
            <views:BackupView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== SIDEBAR LATERAL (DARK NAVY #0B192C) — IGUAL A LA WEB ==================== -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBgBrush}" BorderBrush="{StaticResource SidebarBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">

                <!-- LOGO SUPERIOR (EXACTO AL WEB) -->
                <Border DockPanel.Dock="Top" Height="56" BorderBrush="#152C4C" BorderThickness="0,0,0,1" Padding="18,0" WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" ClipToBounds="True" BorderBrush="#3B82F6" BorderThickness="1" Margin="0,0,10,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#3B82F6" Opacity="0.2" BlurRadius="6" ShadowDepth="0"/>
                            </Border.Effect>
                            <Border Background="#1E40AF" CornerRadius="7">
                                <TextBlock Text="FP" FontWeight="Bold" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="FacturaPro " FontWeight="Bold" FontSize="14" Foreground="White"/>
                                <TextBlock Text="360" FontSize="14" Foreground="#60A5FA" FontWeight="Normal"/>
                            </StackPanel>
                            <TextBlock Text="ENTERPRISE SUITE" FontSize="8" FontWeight="ExtraBold" Foreground="#64748B" Margin="0,1,0,0" LetterSpacing="1"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- MENÚ DE NAVEGACIÓN PRINCIPAL -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel Margin="10,0,10,10">

                        <!-- INICIO (DASHBOARD) — con fondo azul activo como la web -->
                        <Button Style="{StaticResource NavBtnActive}" Command="{Binding NavegarADashboardCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
                                      Stroke="#94A3B8" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Inicio"/>
                            </StackPanel>
                        </Button>

                        <!-- BUSCADOR GLOBAL (CTRL+K) -->
                        <Button Style="{StaticResource NavBtn}" Margin="0,2,0,0">
                            <DockPanel Width="210">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                                          Stroke="#94A3B8" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="Buscador global"/>
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Background="#152C4C" CornerRadius="4" Padding="5,2" HorizontalAlignment="Right">
                                    <TextBlock Text="Ctrl + K" FontSize="9" Foreground="#CBD5E1" FontFamily="Consolas"/>
                                </Border>
                            </DockPanel>
                        </Button>

                        <!-- SECCIÓN: OPERACIONES COMERCIALES -->
                        <Border Margin="8,18,8,6">
                            <TextBlock Text="OPERACIONES COMERCIALES" FontSize="9" FontWeight="ExtraBold" Foreground="#475569" LetterSpacing="0.5"/>
                        </Border>

                        <Button Style="{StaticResource NavBtn}" Command="{Binding NavegarAFacturasCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                                      Stroke="#94A3B8" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Facturación"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavBtn}" Command="{Binding NavegarAClientesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"
                                      Stroke="#94A3B8" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Clientes"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavBtn}" Command="{Binding NavegarAProductosCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"
                                      Stroke="#94A3B8" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Productos e inventario"/>
                            </StackPanel>
                        </Button>

                        <!-- Compras y proveedores (placeholder — módulo web existente) -->
                        <Button Style="{StaticResource NavBtn}" IsEnabled="False" Opacity="0.5" ToolTip="Módulo en desarrollo">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"
                                      Stroke="#94A3B8" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Compras y proveedores"/>
                            </StackPanel>
                        </Button>

                        <!-- Caja y bancos (placeholder — módulo web existente) -->
                        <Button Style="{StaticResource NavBtn}" IsEnabled="False" Opacity="0.5" ToolTip="Módulo en desarrollo">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"
                                      Stroke="#94A3B8" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Caja y bancos"/>
                            </StackPanel>
                        </Button>

                        <!-- SECCIÓN: GESTIÓN Y CONTROL -->
                        <Border Margin="8,18,8,6">
                            <TextBlock Text="GESTIÓN Y CONTROL" FontSize="9" FontWeight="ExtraBold" Foreground="#475569" LetterSpacing="0.5"/>
                        </Border>

                        <!-- Informes de negocio (placeholder) -->
                        <Button Style="{StaticResource NavBtn}" IsEnabled="False" Opacity="0.5" ToolTip="Módulo en desarrollo">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                                      Stroke="#94A3B8" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Informes de negocio"/>
                            </StackPanel>
                        </Button>

                        <!-- Configuración (placeholder) -->
                        <Button Style="{StaticResource NavBtn}" IsEnabled="False" Opacity="0.5" ToolTip="Módulo en desarrollo">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                                      Stroke="#94A3B8" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Configuración"/>
                            </StackPanel>
                        </Button>

                        <!-- Respaldo Criptográfico -->
                        <Button Style="{StaticResource NavBtn}" Command="{Binding NavegarABackupCommand}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                                      Stroke="#94A3B8" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0"/>
                                <TextBlock Text="Respaldo y seguridad"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ==================== CONTENEDOR PRINCIPAL DERECHO ==================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER SUPERIOR (BLANCO CON BORDE LIMPIO) — IGUAL A LA WEB -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- BUSCADOR GLOBAL (igual al web) -->
                    <Border Grid.Column="0" HorizontalAlignment="Left" Background="#F8FAFC" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,6" MaxWidth="380" Cursor="Hand">
                        <DockPanel>
                            <Path Data="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                                  Stroke="#94A3B8" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"/>
                            <TextBlock Text="Buscar en el sistema..." FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <Border DockPanel.Dock="Right" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="12,0,0,0" HorizontalAlignment="Right">
                                <TextBlock Text="Ctrl + K" FontSize="9" Foreground="#94A3B8" FontFamily="Consolas"/>
                            </Border>
                        </DockPanel>
                    </Border>

                    <!-- SELECTOR DE EMPRESA (igual al web) -->
                    <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,5" Margin="12,0,0,0" Cursor="Hand"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource EmeraldBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding EmpresaNombre}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" MaxWidth="180" TextTrimming="CharacterEllipsis"/>
                            <Path Data="M19 9l-7 7-7-7" Stroke="#94A3B8" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- PERFIL DE USUARIO (igual al web) -->
                    <Border Grid.Column="2" Margin="12,0,0,0" Padding="12,0,0,0" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1,0,0,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand">
                            <!-- Avatar -->
                            <Border Width="34" Height="34" CornerRadius="17" Background="#E2E8F0" ClipToBounds="True" BorderBrush="#E2E8F0" BorderThickness="1">
                                <Border Background="LinearGradientBrush" CornerRadius="17">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1D4ED8" Offset="0"/>
                                            <GradientStop Color="#4338CA" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <TextBlock Text="AD" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                            <!-- Nombre y rol -->
                            <StackPanel Margin="10,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UsuarioNombre}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextDarkBrush}" MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Administrador" FontSize="9" Foreground="#94A3B8"/>
                            </StackPanel>
                            <Path Data="M19 9l-7 7-7-7" Stroke="#94A3B8" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform"/>
                            <!-- Botones de ventana -->
                            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
                                <Button x:Name="MinimizeBtn" Click="MinimizeBtn_Click" Width="36" Height="36" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Minimizar">
                                    <Path Data="M20 12H4" Stroke="#94A3B8" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="MaximizeBtn" Click="MaximizeBtn_Click" Width="36" Height="36" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Maximizar">
                                    <Path Data="M4 4h16v16H4z" Stroke="#94A3B8" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform"/>
                                </Button>
                                <Button x:Name="CloseBtn" Click="CloseBtn_Click" Width="36" Height="36" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Cerrar">
                                    <Path Data="M6 18L18 6M6 6l12 12" Stroke="#94A3B8" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform"/>
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#E11D48"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- VISTA ACTIVA -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="{StaticResource CanvasBgBrush}">
                <ContentControl Content="{Binding CurrentView}" Margin="24,20,24,24"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
