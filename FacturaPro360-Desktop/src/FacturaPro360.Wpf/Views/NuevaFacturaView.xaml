<UserControl x:Class="FacturaPro360.Wpf.Views.NuevaFacturaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- SELECCIÓN DE CLIENTE Y FECHAS -->
        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Cliente / Razón Social *" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <ComboBox ItemsSource="{Binding Clientes}" 
                              SelectedItem="{Binding ClienteSeleccionado}" 
                              DisplayMemberPath="RazonSocial"
                              Height="36" FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="Fecha Vencimiento" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <DatePicker SelectedDate="{Binding FechaVencimiento}" Height="36" FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Notas / Condiciones" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding Notas, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TABLA DINÁMICA DE ITEMS -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,16" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- SELECTOR DE PRODUCTO RÁPIDO -->
                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="Líneas de la Factura" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding CatalogoProductos}" 
                                  SelectedItem="{Binding ProductoSeleccionado}"
                                  DisplayMemberPath="Nombre" 
                                  Width="300" Height="34" Margin="0,0,10,0"/>
                        <Button Style="{StaticResource SuccessBtn}" Content="Agregar Ítem" Command="{Binding AgregarProductoCommand}"/>
                    </StackPanel>
                </DockPanel>

                <!-- GRID DE ÍTEMS -->
                <DataGrid Grid.Row="1" Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding Items}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Producto.Nombre}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding Producto.SKU}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                        <DataGridTextColumn Header="Precio Unit." Binding="{Binding PrecioUnitario, StringFormat='{}{0:N2}', UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        <DataGridTextColumn Header="Desc. %" Binding="{Binding DescuentoPorcentaje, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        <DataGridTextColumn Header="IVA %" Binding="{Binding IvaPorcentaje, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat='{}{0:N2}'}" Width="110" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='{}{0:N2}'}" Width="120" FontWeight="Bold" IsReadOnly="True"/>
                        <DataGridTemplateColumn Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource DangerBtn}" Content="Quitar" Padding="6,2" FontSize="10"
                                            Command="{Binding DataContext.EliminarItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- TOTALES Y CONFIRMACIÓN -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Cálculo exacto en capa de dominio (ACID)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,24,0" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Subtotal, StringFormat='Subtotal: {0:C2}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding DescuentoTotal, StringFormat='Descuento: -{0:C2}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding ImpuestoTotal, StringFormat='IVA: +{0:C2}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding Total, StringFormat='TOTAL: {0:C2}'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Style="{StaticResource PrimaryBtn}" Content="Emitir Factura Ahora" FontSize="14" Padding="20,12"
                            Command="{Binding EmitirFacturaCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
