<UserControl x:Class="FacturaPro360.Wpf.Views.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABECERA -->
        <Border Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Catálogo de Productos y Control de Inventario (Kardex)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
        </Border>

        <!-- FORMULARIO CREAR PRODUCTO -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Registrar Nuevo Producto" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="SKU *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NuevoSku, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Nombre del Producto *" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NuevoNombre, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <TextBlock Text="Precio Venta ($)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NuevoPrecioVenta, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <TextBlock Text="Costo ($)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NuevoCosto, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4" Margin="0,0,10,0">
                        <TextBlock Text="Stock Inicial" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Text="{Binding NuevoStock, UpdateSourceTrigger=PropertyChanged}" Height="34"/>
                    </StackPanel>

                    <Button Grid.Column="5" Style="{StaticResource PrimaryBtn}" Content="Guardar Producto" Command="{Binding CrearProductoCommand}" Height="34" VerticalAlignment="Bottom"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- GRID PRODUCTOS -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="0">
            <DataGrid Style="{StaticResource ModernDataGrid}" ItemsSource="{Binding Productos}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="140" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Nombre del Producto" Binding="{Binding Nombre}" Width="*"/>
                    <DataGridTextColumn Header="Precio Venta" Binding="{Binding PrecioVenta, StringFormat='{}{0:C2}'}" Width="130"/>
                    <DataGridTextColumn Header="Costo Prom." Binding="{Binding CostoPromedio, StringFormat='{}{0:C2}'}" Width="130"/>
                    <DataGridTextColumn Header="Stock Actual" Binding="{Binding StockActual, StringFormat='{}{0:N2}'}" Width="120" FontWeight="Bold"/>
                    <DataGridTextColumn Header="Stock Mínimo" Binding="{Binding StockMinimo, StringFormat='{}{0:N2}'}" Width="110"/>
                    <DataGridTextColumn Header="IVA %" Binding="{Binding IvaPorcentaje, StringFormat='{}{0}%'}" Width="80"/>
                    
                    <DataGridTemplateColumn Header="Acción" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource DangerBtn}" Content="Eliminar"
                                        Command="{Binding DataContext.EliminarProductoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
